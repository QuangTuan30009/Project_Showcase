# Docker local environment example
# Copy this file to .env if you want to customize values later.

# Backend
PORT=5000
NODE_ENV=production
MONGODB_URI=mongodb://mongo:27017/project_showcase
CORS_ORIGINS=http://localhost:8080,http://localhost:5173,https://project-showcase-phi.vercel.app

# Frontend build arg (used in docker-compose.yml)
VITE_API_URL=http://localhost:5000/api
